{
  "sampleNotice": "Windows Admin 双轨开发示例：以 E:\\phoenix 为讲解工作区，进行中使用 worktrees 下平铺的 <项目名>-working，稳定测试使用主工作目录。发布验证与 Midway 4 不属于本示例。复制为 config/services.user.json 后复核路径、分支、Manifest、端口和 pnpm 入口；不要写入 commit SHA、凭据、token 或个人运行时路径。",
  "version": 2,
  "series": [
    {
      "id": "phoenix-admin",
      "name": "Phoenix Admin",
      "template": {
        "runtimeSlot": "phoenix-admin",
        "services": {
          "web": {
            "name": "Phoenix Admin Web",
            "description": "Cool Admin Vue 前端",
            "command": { "executable": "pnpm", "args": ["dev"] },
            "endpoints": [
              { "id": "web", "label": "Web", "port": 9000, "openUrl": "http://127.0.0.1:9000/", "healthUrl": "http://127.0.0.1:9000/" }
            ],
            "externalStop": "confirm-matching-cwd",
            "startOrder": 20
          },
          "api": {
            "name": "Phoenix Admin API",
            "description": "Admin Node 开发服务",
            "command": { "executable": "pnpm", "args": ["dev"] },
            "endpoints": [
              { "id": "api", "label": "API", "port": 8101, "openUrl": "http://127.0.0.1:8101/", "healthUrl": "http://127.0.0.1:8101/index.html" }
            ],
            "externalStop": "confirm-matching-cwd",
            "startOrder": 10
          }
        }
      },
      "profiles": [
        {
          "id": "working",
          "name": "Admin 进行中",
          "runtimeSlot": "phoenix-admin-working",
          "metadata": {
            "description": "平铺 working worktree；通过本机链接消费 working 插件 worktree",
            "wingVersion": "Registry 0.7.5"
          },
          "services": {
            "web": { "id": "admin-working-web", "cwd": "E:\\phoenix\\worktrees\\phoenix-admin-vue-working" },
            "api": { "id": "admin-working-api", "cwd": "E:\\phoenix\\worktrees\\phoenix-admin-node-working" }
          }
        },
        {
          "id": "stable-test",
          "name": "Admin 稳定测试",
          "runtimeSlot": "phoenix-admin-stable-test",
          "metadata": {
            "description": "主工作目录；通过 Hub 受控挂载主库插件",
            "wingVersion": "Registry 0.7.5",
            "sourceBaseline": "phoenix-wing Registry 0.7.5"
          },
          "services": {
            "web": {
              "id": "admin-stable-test-web",
              "name": "Phoenix Admin 稳定测试 Web",
              "cwd": "E:\\phoenix\\phoenix-admin-vue",
              "command": {
                "args": ["dev", "--host", "127.0.0.1", "--strictPort", "--port", "9100"],
                "env": { "PAH_API_TARGET": "http://127.0.0.1:8201", "VITE_PAH_API_TARGET": "http://127.0.0.1:8201" }
              },
              "endpoints": [
                { "id": "web", "label": "Web", "port": 9100, "openUrl": "http://127.0.0.1:9100/", "healthUrl": "http://127.0.0.1:9100/" }
              ]
            },
            "api": {
              "id": "admin-stable-test-api",
              "name": "Phoenix Admin 稳定测试 API",
              "cwd": "E:\\phoenix\\phoenix-admin-node",
              "command": {
                "env": { "PAH_SERVER_PORT": "8201", "PAH_DB_SYNCHRONIZE": "false", "PAH_DB_INITIALIZE": "false" }
              },
              "endpoints": [
                { "id": "api", "label": "API", "port": 8201, "openUrl": "http://127.0.0.1:8201/", "healthUrl": "http://127.0.0.1:8201/index.html" }
              ]
            }
          }
        }
      ]
    }
  ]
}
